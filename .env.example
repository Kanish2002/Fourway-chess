# Required for hosted multiplayer; never expose these to browser code.
# Connect an Upstash Redis database to the Vercel project (Preview and Production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local npm run dev uses a single-process in-memory room store when these are absent.
# To use shared storage locally: node --env-file=.env.local scripts/serve.mjs
